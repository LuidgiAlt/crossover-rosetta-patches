+/* Experimental, opt-in instruction stepping; never modifies executable bytes. */
+static BOOL rosetta_exec_breakpoints( struct amd64_thread_data *data )
+{
+#ifdef __APPLE__
+    unsigned int i;
+    if (!is_rosetta2 || !emulate_rosetta_exec_breakpoints) return FALSE;
+    if (is_wow64() && !emulate_rosetta_wow64_breakpoints) return FALSE;
+    for (i = 0; i < 4; i++)
+        if (((data->dr7 >> (2 * i)) & 3) && !((data->dr7 >> (16 + 4 * i)) & 15))
+            return TRUE;
+#endif
+    return FALSE;
+}
+
+
+struct xcontext;
+static void setup_raise_exception( ucontext_t *sigcontext, EXCEPTION_RECORD *rec, struct xcontext *xcontext );
+
+static unsigned int rosetta_breakpoint_hits( struct amd64_thread_data *debug, ULONG_PTR pc, DWORD flags )
+{
+    ULONG_PTR addresses[4] = { debug->dr0, debug->dr1, debug->dr2, debug->dr3 };
+    unsigned int i, hits = 0;
+
+    if (flags & 0x10000) return 0;
+    for (i = 0; i < 4; i++)
+        if (((debug->dr7 >> (2 * i)) & 3) && !((debug->dr7 >> (16 + 4 * i)) & 15)
+            && addresses[i] == pc) hits |= 1 << i;
+    return hits;
+}
+
+static NTSTATUS rosetta_initial_breakpoint(void);
+
+#ifdef __APPLE__
+#include <mach/mach_time.h>
+/* Optional measurement (WINE_ROSETTA_STATS=1): once per second, report how many
+ * instructions were single-stepped and how many breakpoints were delivered.
+ * Uses only write(2) so it is safe inside the signal handler. */
+static BOOL rosetta_stats;
+static volatile LONG rosetta_steps, rosetta_hits, rosetta_threads_mask, rosetta_steps64;
+static UINT64 rosetta_stats_last;
+
+static char *rosetta_utoa( char *p, unsigned long v )
+{
+    char tmp[24]; int n = 0;
+    do tmp[n++] = '0' + v % 10; while ((v /= 10));
+    while (n) *p++ = tmp[--n];
+    return p;
+}
+
+static int rosetta_stats_level;
+static volatile LONG rosetta_steps_total, rosetta_steps64_total;
+
+static char *rosetta_hex( char *p, ULONG_PTR v )
+{
+    static const char digits[] = "0123456789abcdef";
+    char tmp[16]; int n = 0;
+    do tmp[n++] = digits[v & 15]; while ((v >>= 4));
+    *p++ = '0'; *p++ = 'x';
+    while (n) *p++ = tmp[--n];
+    return p;
+}
+
+/* WINE_ROSETTA_STATS=2: one line per breakpoint arm/hit, for working out
+ * which addresses and threads the emulation serves. Signal-safe. */
+static void rosetta_event( const char *kind, struct amd64_thread_data *d, ULONG_PTR pc, unsigned int cs )
+{
+    static mach_timebase_info_data_t tb;
+    static LONG last_total, last64;
+    char buf[256], *p = buf;
+    LONG total = rosetta_steps_total, total64 = rosetta_steps64_total;
+
+    if (rosetta_stats_level < 2) return;
+    if (!tb.denom) mach_timebase_info( &tb );
+    memcpy( p, "rosetta-ev: ", 12 ); p += 12;
+    while (*kind) *p++ = *kind++;
+    memcpy( p, " tid ", 5 ); p += 5;
+    p = rosetta_utoa( p, HandleToULong( NtCurrentTeb()->ClientId.UniqueThread ) );
+    memcpy( p, " pc ", 4 ); p += 4; p = rosetta_hex( p, pc );
+    memcpy( p, cs == cs32_sel ? " x86" : " x64", 4 ); p += 4;
+    memcpy( p, " dr7 ", 5 ); p += 5; p = rosetta_hex( p, d->dr7 );
+    memcpy( p, " dr0 ", 5 ); p += 5; p = rosetta_hex( p, d->dr0 );
+    memcpy( p, " dr1 ", 5 ); p += 5; p = rosetta_hex( p, d->dr1 );
+    memcpy( p, " dr2 ", 5 ); p += 5; p = rosetta_hex( p, d->dr2 );
+    memcpy( p, " dr3 ", 5 ); p += 5; p = rosetta_hex( p, d->dr3 );
+    memcpy( p, " steps ", 7 ); p += 7; p = rosetta_utoa( p, (unsigned long)(total - last_total) );
+    last_total = total;
+    memcpy( p, " (64-bit ", 9 ); p += 9; p = rosetta_utoa( p, (unsigned long)(total64 - last64) ); *p++ = ')';
+    last64 = total64;
+    *p++ = ' '; p = rosetta_utoa( p, (unsigned long)(mach_absolute_time() * tb.numer / tb.denom / 1000000) );
+    memcpy( p, "ms\n", 3 ); p += 3;
+    write( 2, buf, p - buf );
+}
+
+static void rosetta_stats_note( BOOL hit, BOOL in64 )
+{
+    static mach_timebase_info_data_t tb;
+    UINT64 now;
+    char buf[160], *p;
+
+    if (!rosetta_stats) return;
+    if (!hit) InterlockedIncrement( &rosetta_steps_total );
+    if (!hit && in64) { InterlockedIncrement( &rosetta_steps64 ); InterlockedIncrement( &rosetta_steps64_total ); }
+    if (hit) InterlockedIncrement( &rosetta_hits ); else InterlockedIncrement( &rosetta_steps );
+    InterlockedOr( &rosetta_threads_mask, 1 << (HandleToULong( NtCurrentTeb()->ClientId.UniqueThread ) % 31) );
+    if (!tb.denom) mach_timebase_info( &tb );
+    now = mach_absolute_time() * tb.numer / tb.denom;
+    if (now - rosetta_stats_last < 1000000000ull) return;
+    rosetta_stats_last = now;
+    p = buf;
+    memcpy( p, "rosetta-bp: pid ", 16 ); p += 16;
+    p = rosetta_utoa( p, getpid() );
+    memcpy( p, " steps/s ", 9 ); p += 9;
+    p = rosetta_utoa( p, InterlockedExchange( &rosetta_steps, 0 ) );
+    memcpy( p, " (64-bit ", 9 ); p += 9;
+    p = rosetta_utoa( p, InterlockedExchange( &rosetta_steps64, 0 ) );
+    *p++ = ')';
+    memcpy( p, " hits/s ", 8 ); p += 8;
+    p = rosetta_utoa( p, InterlockedExchange( &rosetta_hits, 0 ) );
+    memcpy( p, " threads ", 9 ); p += 9;
+    p = rosetta_utoa( p, __builtin_popcount( InterlockedExchange( &rosetta_threads_mask, 0 ) ) );
+    *p++ = ' '; p = rosetta_utoa( p, (unsigned long)(now / 1000000) );
+    memcpy( p, "ms\n", 3 ); p += 3;
+    write( 2, buf, p - buf );
+}
+#endif
