+                regs.ContextFlags = CONTEXT_DEBUG_REGISTERS;
+                set_thread_context( GetCurrentThread(), &regs, &self, IMAGE_FILE_MACHINE_AMD64 );
+                amd64_data->emulated_step = FALSE;
+                rosetta_stats_note( TRUE, FALSE );
+                rosetta_event( "hit-resume", amd64_data, context->Rip, context->SegCs );
+                setup_raise_exception( sigcontext, &rec, &fault );
+                return;
+            }
+        }
+    }
+#endif
     leave_handler( sigcontext );
 }
 
